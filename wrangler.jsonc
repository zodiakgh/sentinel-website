{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel-website",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sentinel-lookup",
      "database_id": "b8bff874-234a-4b02-b647-1ea77cfd9a22"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "0e21aa9ea6a543f5b999552804c68e26"
    }
  ]
}
