{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sentinel-analytics",
      "database_id": "10f07804-4a1a-4178-a84e-6b97414fcf03",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "sentinel-analytics-preview",
        "database_id": "11fb957e-e59c-434e-9663-e46b1583b2d1",
        "migrations_dir": "migrations"
      }
    ]
  }
}
